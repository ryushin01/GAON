{
  "outDir": "public/fonts",
  "scan": ["src", "app"],
  "dataExtensions": ["json"],
  "extra": "년월일시분초오전후요화수목금토만억조",
  "fonts": [
    {
      "family": "GaonSans",
      "slug": "gaon-sans",
      "weights": {
        "300": "scripts/fonts/hahmlet/Hahmlet-300.woff2",
        "500": "scripts/fonts/hahmlet/Hahmlet-500.woff2",
        "700": "scripts/fonts/hahmlet/Hahmlet-700.woff2"
      }
    }
  ],
  "appFonts": {
    "scan": ["scripts/generate-media.py"],
    "pairs": [
      ["assets/fonts/NanumGothicCoding-Regular.ttf", "assets/fonts/GaonMono-app.ttf"],
      ["assets/fonts/LINESeedKR-Thin.ttf", "assets/fonts/LINESeedKR-Thin-subset.ttf"],
      ["assets/fonts/LINESeedKR-Regular.ttf", "assets/fonts/LINESeedKR-Regular-subset.ttf"],
      ["assets/fonts/LINESeedKR-Bold.ttf", "assets/fonts/LINESeedKR-Bold-subset.ttf"]
    ]
  }
}
