{
  "appId": "com.ryushin01.gaon",
  "productName": "GAON",
  "copyright": "Copyright © 2026 ryushin01",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "files": [
    "electron/**",
    "dist/**",
    "!node_modules/**"
  ],
  "extraResources": [
    {
      "from": "native/build",
      "to": "native",
      "filter": [
        "gaon-audio",
        "gaon-audio.exe"
      ]
    }
  ],
  "npmRebuild": false,
  "icon": "assets/icon.png",
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.music",
    "identity": null
  },
  "dmg": {
    "artifactName": "GAON-${version}-macos-${arch}.${ext}"
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "artifactName": "GAON-${version}-windows-${arch}-setup.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Audio"
  }
}
